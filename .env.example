# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iinhouse?schema=public"

# ─── NextAuth ────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-char-string-with-openssl-rand-base64-32"

# ─── Demo Mode ──────────────────────────────────────────────
# Set to "true" to bypass DB with in-memory demo users
DEMO_MODE="false"

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@iinhouse.com"

# ─── Storage (AWS S3 / Cloudflare R2) ───────────────────────
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
# Alternative direct env vars (used in lib/storage.ts)
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL=""

# ─── Razorpay (Indian payments) ─────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ─── Stripe (international, optional) ──────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── DRM ───────────────────────────────────────────────────
DRM_PROVIDER="dev"
DRM_API_KEY=""

# ─── Watermark & signed URLs ───────────────────────────────
WATERMARK_SECRET=""
SIGNED_URL_TTL_SECONDS="3600"

# ─── Cron ──────────────────────────────────────────────────
CRON_SECRET=""

# ─── Upstash Redis (rate limiting, optional) ───────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
