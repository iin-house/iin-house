DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iin_house?schema=public"
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Storage (S3-compatible — Cloudflare R2, AWS S3, Backblaze B2, MinIO)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""

# Payments — Stripe recommended
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Content protection
WATERMARK_SECRET="change-me"
SIGNED_URL_TTL_SECONDS=3600

# DRM provider (gumlet, keyos, or dev)
DRM_PROVIDER="dev"
DRM_API_KEY=""

# Email (Resend)
RESEND_API_KEY=""

# Cron secret for scheduled content publishing
CRON_SECRET=""

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Demo mode (enable for local development)
DEMO_MODE="false"
