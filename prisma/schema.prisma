generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CREATOR
  SUBSCRIBER
  ADMIN
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  TRIAL
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ContentType {
  TEXT
  PHOTO
  VIDEO
  AUDIO
}

enum Visibility {
  PUBLIC
  SUBSCRIBERS
  PPV
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ── User ────────────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  phone         String?        @unique
  passwordHash  String
  role          UserRole       @default(SUBSCRIBER)
  kycStatus     KycStatus      @default(PENDING)
  ageVerified   Boolean        @default(false)
  twoFAEnabled  Boolean        @default(false)
  twoFASecret   String?
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  creatorProfile      CreatorProfile?
  subscriptions       Subscription[]      @relation("Subscriber")
  messagesSent        Message[]           @relation("Sender")
  messagesReceived    Message[]           @relation("Receiver")
  ppvPurchases        PPVPurchase[]
  flagsRaised         ModerationFlag[]    @relation("Flagger")
  flagsReviewed       ModerationFlag[]    @relation("Reviewer")
  auditLogs           AuditLog[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  kycDocuments        KycDocument[]
  disputes            Dispute[]

  @@index([email])
  @@index([phone])
}

// ── Creator ─────────────────────────────────────────────────────────────────

model CreatorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  bio                String?
  profileImageUrl    String?
  coverImageUrl      String?
  verificationStatus VerificationStatus @default(PENDING)
  revenueSplitPct    Decimal            @default(80)
  contractId         String?
  contract           Contract?          @relation(fields: [contractId], references: [id])
  createdAt          DateTime           @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiers           SubscriptionTier[]
  posts           ContentPost[]
  subscriptions   Subscription[]
  payouts         Payout[]

  @@index([displayName])
}

// ── Subscription Tier ───────────────────────────────────────────────────────

model SubscriptionTier {
  id               String   @id @default(cuid())
  creatorId        String
  name             String
  price            Decimal
  currency         String   @default("INR")
  perksDescription String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  creator        CreatorProfile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([creatorId])
}

// ── Subscription ────────────────────────────────────────────────────────────

model Subscription {
  id           String             @id @default(cuid())
  subscriberId String
  creatorId    String
  tierId       String
  status       SubscriptionStatus @default(ACTIVE)
  startedAt    DateTime           @default(now())
  renewedAt    DateTime?
  cancelledAt  DateTime?
  periodStart  DateTime?
  periodEnd    DateTime?

  subscriber User             @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator    CreatorProfile   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tier       SubscriptionTier @relation(fields: [tierId], references: [id])

  @@index([subscriberId, creatorId])
  @@index([creatorId, status])
}

// ── Content Post ────────────────────────────────────────────────────────────

model ContentPost {
  id           String        @id @default(cuid())
  creatorId    String
  type         ContentType   @default(TEXT)
  caption      String?
  mediaUrl     String?
  thumbnailUrl String?
  watermarkedUrl String?
  durationSec  Int?
  isPPV        Boolean       @default(false)
  ppvPrice     Decimal?
  visibility   Visibility    @default(PUBLIC)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  views        Int           @default(0)
  createdAt    DateTime      @default(now())

  creator    CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  ppvBuyers  PPVPurchase[]
  flags      ModerationFlag[]

  @@index([creatorId, createdAt])
  @@index([creatorId, publishedAt])
}

// ── PPV Purchase ────────────────────────────────────────────────────────────

model PPVPurchase {
  id           String   @id @default(cuid())
  subscriberId String
  contentId    String
  amount       Decimal
  paymentId    String?
  refunded     Boolean  @default(false)
  refundedAt   DateTime?
  purchasedAt  DateTime @default(now())

  subscriber User        @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  content    ContentPost @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, contentId])
  @@index([contentId])
  @@index([paymentId])
}

// ── Message ─────────────────────────────────────────────────────────────────

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  encrypted  Boolean  @default(false)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User         @relation("Sender",    fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User         @relation("Receiver",  fields: [receiverId], references: [id], onDelete: Cascade)
  reads    MessageRead[]

  @@index([senderId, receiverId])
  @@index([receiverId, createdAt])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([messageId])
}

// ── Payout ──────────────────────────────────────────────────────────────────

model Payout {
  id          String        @id @default(cuid())
  creatorId   String
  amount      Decimal
  currency    String        @default("INR")
  status      PayoutStatus  @default(PENDING)
  requestedAt DateTime      @default(now())
  processedAt DateTime?
  reference   String?

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, status])
}

// ── Contract ────────────────────────────────────────────────────────────────

model Contract {
  id              String   @id @default(cuid())
  documentUrl     String
  revenueSplitPct Decimal
  termsVersion    String
  signedAt        DateTime?
  createdAt       DateTime @default(now())

  creators CreatorProfile[]
}

// ── Moderation ──────────────────────────────────────────────────────────────

model ModerationFlag {
  id          String   @id @default(cuid())
  contentId   String
  flaggedBy   String
  reason      String
  status      String   @default("OPEN")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  content  ContentPost @relation(fields: [contentId], references: [id], onDelete: Cascade)
  flagger  User        @relation("Flagger", fields: [flaggedBy], references: [id])
  reviewer User?       @relation("Reviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([contentId])
}

// ── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action])
}

// ── Verification & Auth ─────────────────────────────────────────────────────

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String    @unique
  email     String?
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KycDocument {
  id           String   @id @default(cuid())
  userId       String
  documentType String
  documentUrl  String
  status       String   @default("PENDING")
  reviewedBy   String?
  reviewedAt   DateTime?
  notes        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Dispute ─────────────────────────────────────────────────────────────────

model Dispute {
  id          String   @id @default(cuid())
  userId      String
  type        String
  description String
  status      String   @default("OPEN")
  resolvedBy  String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
